rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user is the owner of the document (by ID) -- mostly for Users collection
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if the user is a Global Admin using Custom Claims (with DB fallback)
    function isGlobalAdmin() {
      return (request.auth.token.keys().hasAny(['role']) && request.auth.token.role == 'admin') ||
             (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Helper to check Token Claims
    function hasTokenRole(companyId, allowedRoles) {
      return (request.auth.token.keys().hasAny(['role']) && request.auth.token.role == 'admin') ||
             (request.auth.token.keys().hasAny(['companyRoles']) && 
              request.auth.token.companyRoles.keys().hasAny([companyId]) && 
              request.auth.token.companyRoles[companyId] in allowedRoles);
    }

    // Helper to check Firestore Document (Fallback)
    function hasDbRole(companyId, allowedRoles) {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || 
              (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.keys().hasAny(['companyRoles']) && 
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyRoles.keys().hasAny([companyId]) && 
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyRoles[companyId] in allowedRoles));
    }

    // Check if the user has a specific role within a company using Custom Claims or DB Fallback
    function hasCompanyRole(companyId, allowedRoles) {
      return hasTokenRole(companyId, allowedRoles) || hasDbRole(companyId, allowedRoles);
    }
    
    // Helper for "Manager or Admin" check (Common pattern)
    function isManager(companyId) {
       return hasCompanyRole(companyId, ['financial_manager']);
    }

    // --- Collection Rules ---

    // Legal Documents (Public Read, Admin Write)
    match /legal_documents/{docId} {
      allow read: if true;
      allow write: if isGlobalAdmin();
      
      match /versions/{versionId} {
        allow read: if true;
        allow write: if isGlobalAdmin();
      }
    }

    // 1. Users Collection
    // - Read: All authenticated users (needed for interactions, assigning users, etc.)
    // - Write: Owner can edit self (with restrictions); Global Admin can edit all.
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated(); // Allow creation during sign-up
      allow update: if isGlobalAdmin() || (
        isOwner(userId) && 
        // Owner cannot change critical fields directly
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'companyRoles', 'active']) &&
        // If Owner changes status, it must be to 'pending_approval' (Invite-Only flow)
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) || request.resource.data.status == 'pending_approval')
      );
      allow delete: if isGlobalAdmin();
    }

    // 2. Companies Collection
    // - Read: Authenticated users.
    // - Create: Authenticated users (Invite-Only / Setup flow).
    // - Update/Delete: Global Admin only; Financial Manager can increment rdCounter.
    match /companies/{companyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow delete: if isGlobalAdmin();
      allow update: if isGlobalAdmin() ||
        (hasCompanyRole(companyId, ['financial_manager', 'user']) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rdCounter']));

      // Subcoleção: sugestões de lotes geradas pela Cloud Function noturna.
      // Leitura: roles que gerenciam lotes de pagamento.
      // Escrita: bloqueada no client — somente o Admin SDK (Cloud Function) escreve.
      match /suggested_batches/{suggestionId} {
        allow read: if isAuthenticated() &&
          hasCompanyRole(companyId, ['financial_manager', 'approver', 'releaser']);
        allow write: if false; // Cloud Function only (Admin SDK bypasses rules)
      }
    }

    // 3. Transactions (Payables & Receivables)
    match /transactions/{transactionId} {
      // Helper to get companyId from the document being accessed/created
      function getCompanyId() {
        return resource != null ? resource.data.companyId : request.resource.data.companyId;
      }

      // Papéis autorizados a escrever, independentemente do conteúdo da escrita.
      function canWrite() {
        return isManager(getCompanyId()) ||
               hasCompanyRole(getCompanyId(), ['approver']) ||
               hasCompanyRole(getCompanyId(), ['releaser']) ||
               (hasCompanyRole(getCompanyId(), ['user']) && resource.data.createdBy == request.auth.uid);
      }

      // ───────────────────────────────────────────────────────────────────────
      // Orçamento por envelope
      //
      // A invariante `recebido − alocadoAosFilhos − gastoDireto >= 0` não é
      // expressável aqui: conferi-la exige ler o razão do centro e de todos os
      // ancestrais na mesma operação em que se grava. Quem faz isso são os
      // callables (`createPayableTransaction`, `createPayableInstallments`,
      // `updatePayableTransaction`, `setTransactionStatus`), que rodam com o
      // Admin SDK e por isso não passam por estas regras.
      //
      // O papel das regras é o inverso: fechar o caminho direto, para que o
      // callable seja o único jeito de uma despesa nascer ou mudar de valor.
      // ───────────────────────────────────────────────────────────────────────

      // Campos de que o cálculo do envelope depende.
      function budgetKeys() {
        return [
          'type', 'amount', 'finalAmount',
          'costCenterAllocation', 'costCenterId', 'costCenterIds',
          'dueDate', 'paymentDate',
          'budgetExceeded', 'budgetExceededReason',
          'ledgerApplied', 'ledgerAppliedAt'
        ].toSet();
      }

      // Vale tanto para a despesa que já é quanto para a que a escrita tornaria.
      function isPayableWrite() {
        return resource.data.get('type', '') == 'payable' ||
               request.resource.data.get('type', '') == 'payable';
      }

      function keepsBudgetFields() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(budgetKeys());
      }

      // Rejeitar devolve envelope e é sempre seguro. Tirar de `rejected` reocupa
      // o que a recusa liberou — e esse espaço pode já ter sido gasto noutro
      // lugar —, então essa volta só existe pelo `setTransactionStatus`.
      // As demais transições (rascunho → aprovada → paga, inclusive em lote)
      // não mudam quanto a despesa consome, e seguem livres.
      function keepsRejection() {
        return resource.data.get('status', '') != 'rejected' ||
               request.resource.data.get('status', '') == 'rejected';
      }

      // READ
      allow read: if isAuthenticated() && (
        // Admin, Manager, Approver, Releaser, Auditor: Can view ALL in the company
        hasCompanyRole(getCompanyId(), ['financial_manager', 'approver', 'releaser', 'auditor']) ||

        // User: Can view ONLY their own transactions (Created By them)
        (hasCompanyRole(getCompanyId(), ['user']) && resource.data.createdBy == request.auth.uid)
      );

      // CREATE — receitas pelo SDK; despesa só pela Cloud Function, que confere
      // o saldo do centro de custo na mesma operação em que grava.
      allow create: if isAuthenticated() &&
        (hasCompanyRole(getCompanyId(), ['financial_manager']) ||
         hasCompanyRole(getCompanyId(), ['user'])) &&
        request.resource.data.get('type', '') != 'payable';

      // UPDATE — numa despesa, tudo que não mexe em orçamento continua livre:
      // vínculo com lote, conciliação, comprovante, anexo, observação, token de
      // aprovação e as mudanças de status do fluxo.
      allow update: if isAuthenticated() && canWrite() && (
         !isPayableWrite() || (keepsBudgetFields() && keepsRejection())
      );

      // DELETE — apagar só devolve envelope; o trigger estorna o razão.
      allow delete: if isAuthenticated() && canWrite();
    }

    // 4. Payment Batches
    match /payment_batches/{batchId} {
       function getCompanyId() { return resource != null ? resource.data.companyId : request.resource.data.companyId; }
       
       allow read: if isAuthenticated() && hasCompanyRole(getCompanyId(), ['financial_manager', 'approver', 'releaser']);
       
       // Write: Managers, Approvers, Releasers (Approve/Pay actions)
       allow write: if isAuthenticated() && (
         isManager(getCompanyId()) || 
         hasCompanyRole(getCompanyId(), ['approver', 'releaser'])
       );
    }

    // 5. Recurring Templates
    match /recurring_templates/{templateId} {
       function getCompanyId() { return resource != null ? resource.data.companyId : request.resource.data.companyId; }

       // Read: Manager, Approver, Releaser
       allow read: if isAuthenticated() && hasCompanyRole(getCompanyId(), ['financial_manager', 'approver', 'releaser']);
       
       // Write: Manager only
       allow write: if isAuthenticated() && isManager(getCompanyId());
    }

    // 6. Cost Centers
    match /cost_centers/{costCenterId} {
       function getCompanyId() { return resource != null ? resource.data.companyId : request.resource.data.companyId; }

       allow read: if isAuthenticated() && hasCompanyRole(getCompanyId(), ['financial_manager', 'approver', 'releaser', 'auditor', 'user']);
       
       allow write: if isAuthenticated() && isManager(getCompanyId());
    }

    // 7. Entities (Participants/Contacts)
    match /entities/{entityId} {
       function getCompanyId() { return resource != null ? resource.data.companyId : request.resource.data.companyId; }

       allow read: if isAuthenticated() && hasCompanyRole(getCompanyId(), ['financial_manager', 'approver', 'releaser', 'auditor', 'user']);
       
       allow write: if isAuthenticated() && isManager(getCompanyId());
    }
    
    // 8. Notifications
    match /notifications/{notificationId} {
       allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid);
       allow write: if isAuthenticated() && (resource != null ? resource.data.userId == request.auth.uid : request.resource.data.userId == request.auth.uid);
    }

    // 9. Audit Logs
    match /audit_logs/{logId} {
        // Read: Admin, Auditor, Approver, Releaser, Manager
        // User role: Cannot access audit logs
        function getCompanyId() { return resource.data.companyId; }
        
        allow read: if isAuthenticated() && (
            isGlobalAdmin() ||
            hasCompanyRole(getCompanyId(), ['auditor', 'approver', 'releaser', 'financial_manager'])
        );
        // Allow authenticated users to create audit logs (client-side logging)
        allow create: if isAuthenticated();
        // Prevent updates and deletes (audit logs should be immutable)
        allow update, delete: if false;
    }

    // 10. Budgets e 12. Cost Center Usage — coleções aposentadas.
    //
    // Eram duas das quatro fontes de verdade que o orçamento por envelope
    // substituiu. Nada as lê nem escreve mais: o saldo vive em
    // `cost_center_ledger` e o detalhamento mensal sai das transações. O acesso
    // fica negado para que nenhum caminho novo volte a depender delas; os
    // documentos antigos seguem no banco até serem apagados.
    match /budgets/{budgetId} {
      allow read, write: if false;
    }
    match /cost_center_usage/{usageId} {
      allow read, write: if false;
    }

    // 11. Feedbacks
    match /feedbacks/{feedbackId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isGlobalAdmin();
    }

    // Regras do Roadmap
    match /roadmap_items/{itemId} {
      allow read: if true; // Público
      allow create: if isAuthenticated(); // Usuários logados
      allow update, delete: if isGlobalAdmin(); // Apenas admins
    }

    // 12b. Cost Center Ledger (envelope budgeting — single source of truth for balance)
    match /cost_center_ledger/{ledgerId} {
       function getCompanyId() { return resource != null ? resource.data.companyId : request.resource.data.companyId; }

       // Read: same roles that can see budgets and reports
       allow read: if isAuthenticated() && hasCompanyRole(getCompanyId(), ['financial_manager', 'approver', 'releaser', 'auditor', 'user']);

       // Write: NEVER from a client, not even a manager.
       // The envelope invariant (sum of children <= parent's available) cannot be
       // expressed in rules, so a direct write would let a manager create money.
       // All mutation goes through Cloud Functions, which bypass these rules.
       allow write: if false;
    }

    // 13. Company Stats (Current Balance)
    match /company_stats/{companyId} {
       // Read: All roles in the company
       allow read: if isAuthenticated() && hasCompanyRole(companyId, ['financial_manager', 'approver', 'releaser', 'auditor', 'user']);
       
       // Write: Manager only (for manual recalculation)
       // Note: Cloud Functions bypass these rules.
       allow write: if isAuthenticated() && isManager(companyId);
    }
    
    // 14. Reconciliation Sessions
    // Read: roles that can view the company's financial movements (view-only for auditor).
    // Write: only roles that actually operate bank reconciliation — 'auditor' is read-only
    // everywhere else in the app, and 'user' (own-payables-only) must not see the full
    // company bank statement nor be able to reconcile arbitrary transactions.
    match /reconciliation_sessions/{companyId} {
       allow read: if isAuthenticated() && hasCompanyRole(companyId, ['financial_manager', 'approver', 'releaser', 'auditor']);
       allow write: if isAuthenticated() && hasCompanyRole(companyId, ['financial_manager', 'releaser']);

       // Bank statement lines live in a subcollection (one doc per line) instead
       // of a single array field — avoids the 1MiB document cap and lets
       // concurrent edits touch one item without clobbering the whole session.
       match /items/{itemId} {
          allow read: if isAuthenticated() && hasCompanyRole(companyId, ['financial_manager', 'approver', 'releaser', 'auditor']);
          allow write: if isAuthenticated() && hasCompanyRole(companyId, ['financial_manager', 'releaser']);
       }
    }
    
    // ── API Externa ──────────────────────────────────────────────────────────

    // 14. API Keys (gerenciamento das chaves de integração externa)
    // Apenas admins globais ou admins da empresa podem criar/revogar keys.
    // O conteúdo real (hashedKey, encryptedSecretKey) nunca deve ser exibido
    // ao client — as leituras aqui são protegidas intencionalmente.
    match /api_keys/{keyId} {
      // Leitura: Admin global ou admin da empresa vinculada à key
      allow read: if isAuthenticated() && (
        isGlobalAdmin() ||
        (resource != null &&
         hasCompanyRole(resource.data.companyId, ['financial_manager']))
      );
      // Criação e revogação: Admin global ou admin da empresa
      allow create: if isAuthenticated() && isGlobalAdmin();
      allow update: if isAuthenticated() && (
        isGlobalAdmin() ||
        (resource != null &&
         hasCompanyRole(resource.data.companyId, ['financial_manager']))
      );
      // Deleção física não permitida — usar revogar (update active: false)
      allow delete: if false;
    }

    // 15. API Audit Logs (log de chamadas da API externa)
    // Escrita apenas via Admin SDK (Cloud Functions / API Routes server-side).
    // Leitura: admins e auditores da empresa.
    match /api_audit_logs/{logId} {
      allow read: if isAuthenticated() && (
        isGlobalAdmin() ||
        (resource != null &&
         hasCompanyRole(resource.data.companyId, ['financial_manager', 'auditor']))
      );
      // Escrita bloqueada pelo client — somente Admin SDK pode escrever
      allow write: if false;
    }

    // 16. Comprovantes (Payment Receipts)
    match /comprovantes/{comprovanteId} {
      function getCompanyId() { return resource != null ? resource.data.companyId : request.resource.data.companyId; }

      // Read: All authenticated roles in the company
      allow read: if isAuthenticated() && hasCompanyRole(getCompanyId(), ['financial_manager', 'approver', 'releaser', 'auditor', 'user']);

      // Create: bloqueado para o client — somente Admin SDK (via /api/internal/comprovantes/process)
      // garante que campos derivados (extractedText, matchConfidence, etc.) são server-authored.
      allow create: if false;

      // Update: Admin e Financial Manager (confirmar/rejeitar/remover match)
      // Campos derivados do servidor não podem ser reatribuídos pelo client.
      // suggestedTransactionId/Ids podem ser limpos (null) mas não reatribuídos.
      allow update: if isAuthenticated() && isManager(getCompanyId()) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'extractedText', 'matchConfidence', 'matchConfidenceLevel',
          'matchedAmount', 'matchedDate', 'matchedEntity',
          'matchReasons', 'matchIsAmbiguous', 'matchAlternatives',
          'fileHash', 'storagePath', 'uploadedBy', 'companyId'
        ]) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['suggestedTransactionId']) ||
         request.resource.data.suggestedTransactionId == null) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['suggestedTransactionIds']) ||
         request.resource.data.suggestedTransactionIds == null);

      // Delete: Admin always; Manager can delete unmatched/rejected/unreadable receipts
      allow delete: if isGlobalAdmin() ||
        (isAuthenticated() && isManager(getCompanyId()) &&
          resource.data.matchStatus in ['unmatched', 'rejected_match', 'needs_manual']);
    }

    // 17. Reimbursement Reports (Relatórios de Despesas / RD)
    match /reimbursement_reports/{reportId} {
      function getCompanyId() {
        return resource != null ? resource.data.companyId : request.resource.data.companyId;
      }

      // Read: all roles in the company
      allow read: if isAuthenticated() &&
        hasCompanyRole(getCompanyId(), ['financial_manager', 'approver', 'releaser', 'auditor', 'user']);

      // Create: financial_manager and user (employees creating their own reports)
      allow create: if isAuthenticated() &&
        hasCompanyRole(getCompanyId(), ['financial_manager', 'user']);

      // Update: financial_manager (approve/reject/pay), approver, releaser
      // Also allow update via magic-link token path (unauthenticated) — handled server-side only
      allow update: if isAuthenticated() &&
        hasCompanyRole(getCompanyId(), ['financial_manager', 'approver', 'releaser']);

      // Delete: financial_manager only, and only drafts
      allow delete: if isAuthenticated() &&
        hasCompanyRole(getCompanyId(), ['financial_manager']) &&
        resource.data.status == 'draft';
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}