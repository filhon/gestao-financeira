rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user is the owner of the document (by ID) -- mostly for Users collection
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if the user is a Global Admin using Custom Claims (with DB fallback)
    function isGlobalAdmin() {
      return (request.auth.token.keys().hasAny(['role']) && request.auth.token.role == 'admin') ||
             (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Helper to check Token Claims
    function hasTokenRole(companyId, allowedRoles) {
      return (request.auth.token.keys().hasAny(['role']) && request.auth.token.role == 'admin') ||
             (request.auth.token.keys().hasAny(['companyRoles']) && 
              request.auth.token.companyRoles.keys().hasAny([companyId]) && 
              request.auth.token.companyRoles[companyId] in allowedRoles);
    }

    // Helper to check Firestore Document (Fallback)
    function hasDbRole(companyId, allowedRoles) {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || 
              (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.keys().hasAny(['companyRoles']) && 
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyRoles.keys().hasAny([companyId]) && 
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyRoles[companyId] in allowedRoles));
    }

    // Check if the user has a specific role within a company using Custom Claims or DB Fallback
    function hasCompanyRole(companyId, allowedRoles) {
      return hasTokenRole(companyId, allowedRoles) || hasDbRole(companyId, allowedRoles);
    }
    
    // Helper for "Manager or Admin" check (Common pattern)
    function isManager(companyId) {
       return hasCompanyRole(companyId, ['financial_manager']);
    }

    // --- Collection Rules ---

    // Legal Documents (Public Read, Admin Write)
    match /legal_documents/{docId} {
      allow read: if true;
      allow write: if isGlobalAdmin();
      
      match /versions/{versionId} {
        allow read: if true;
        allow write: if isGlobalAdmin();
      }
    }

    // 1. Users Collection
    // - Read: All authenticated users (needed for interactions, assigning users, etc.)
    // - Write: Owner can edit self (with restrictions); Global Admin can edit all.
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated(); // Allow creation during sign-up
      allow update: if isGlobalAdmin() || (
        isOwner(userId) && 
        // Owner cannot change critical fields directly
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'companyRoles', 'active']) &&
        // If Owner changes status, it must be to 'pending_approval' (Invite-Only flow)
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) || request.resource.data.status == 'pending_approval')
      );
      allow delete: if isGlobalAdmin();
    }

    // 2. Companies Collection
    // - Read: Authenticated users.
    // - Create: Authenticated users (Invite-Only / Setup flow).
    // - Update/Delete: Global Admin only.
    match /companies/{companyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isGlobalAdmin();

      // Subcoleção: sugestões de lotes geradas pela Cloud Function noturna.
      // Leitura: roles que gerenciam lotes de pagamento.
      // Escrita: bloqueada no client — somente o Admin SDK (Cloud Function) escreve.
      match /suggested_batches/{suggestionId} {
        allow read: if isAuthenticated() &&
          hasCompanyRole(companyId, ['financial_manager', 'approver', 'releaser']);
        allow write: if false; // Cloud Function only (Admin SDK bypasses rules)
      }
    }

    // 3. Transactions (Payables & Receivables)
    match /transactions/{transactionId} {
      // Helper to get companyId from the document being accessed/created
      function getCompanyId() {
        return resource != null ? resource.data.companyId : request.resource.data.companyId;
      }
      
      // READ
      allow read: if isAuthenticated() && (
        // Admin, Manager, Approver, Releaser, Auditor: Can view ALL in the company
        hasCompanyRole(getCompanyId(), ['financial_manager', 'approver', 'releaser', 'auditor']) ||
        
        // User: Can view ONLY their own transactions (Created By them)
        (hasCompanyRole(getCompanyId(), ['user']) && resource.data.createdBy == request.auth.uid)
      );

      // CREATE
      allow create: if isAuthenticated() && (
         // Admin, Manager: Can create both Payables and Receivables
         hasCompanyRole(getCompanyId(), ['financial_manager']) ||
         
         // User: Can create Payables (Logic simplified: allow create if they have 'user' role)
         hasCompanyRole(getCompanyId(), ['user'])
      );

      // UPDATE / DELETE
      allow update, delete: if isAuthenticated() && (
         // Admin, Manager: Full access
         isManager(getCompanyId()) ||
         
         // Approver: Can Update (e.g. Approve)
         hasCompanyRole(getCompanyId(), ['approver']) ||
         
         // Releaser: Can Update (e.g. Pay)
         hasCompanyRole(getCompanyId(), ['releaser']) ||
         
         // User: Can Update/Delete ONLY their own transactions
         (hasCompanyRole(getCompanyId(), ['user']) && resource.data.createdBy == request.auth.uid)
      );
    }

    // 4. Payment Batches
    match /payment_batches/{batchId} {
       function getCompanyId() { return resource != null ? resource.data.companyId : request.resource.data.companyId; }
       
       allow read: if isAuthenticated() && hasCompanyRole(getCompanyId(), ['financial_manager', 'approver', 'releaser']);
       
       // Write: Managers, Approvers, Releasers (Approve/Pay actions)
       allow write: if isAuthenticated() && (
         isManager(getCompanyId()) || 
         hasCompanyRole(getCompanyId(), ['approver', 'releaser'])
       );
    }

    // 5. Recurring Templates
    match /recurring_templates/{templateId} {
       function getCompanyId() { return resource != null ? resource.data.companyId : request.resource.data.companyId; }

       // Read: Manager, Approver, Releaser
       allow read: if isAuthenticated() && hasCompanyRole(getCompanyId(), ['financial_manager', 'approver', 'releaser']);
       
       // Write: Manager only
       allow write: if isAuthenticated() && isManager(getCompanyId());
    }

    // 6. Cost Centers
    match /cost_centers/{costCenterId} {
       function getCompanyId() { return resource != null ? resource.data.companyId : request.resource.data.companyId; }

       allow read: if isAuthenticated() && hasCompanyRole(getCompanyId(), ['financial_manager', 'approver', 'releaser', 'auditor', 'user']);
       
       allow write: if isAuthenticated() && isManager(getCompanyId());
    }

    // 7. Entities (Participants/Contacts)
    match /entities/{entityId} {
       function getCompanyId() { return resource != null ? resource.data.companyId : request.resource.data.companyId; }

       allow read: if isAuthenticated() && hasCompanyRole(getCompanyId(), ['financial_manager', 'approver', 'releaser', 'auditor', 'user']);
       
       allow write: if isAuthenticated() && isManager(getCompanyId());
    }
    
    // 8. Notifications
    match /notifications/{notificationId} {
       allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid);
       allow write: if isAuthenticated() && (resource != null ? resource.data.userId == request.auth.uid : request.resource.data.userId == request.auth.uid);
    }

    // 9. Audit Logs
    match /audit_logs/{logId} {
        // Read: Admin, Auditor, Approver, Releaser, Manager
        // User role: Cannot access audit logs
        function getCompanyId() { return resource.data.companyId; }
        
        allow read: if isAuthenticated() && (
            isGlobalAdmin() ||
            hasCompanyRole(getCompanyId(), ['auditor', 'approver', 'releaser', 'financial_manager'])
        );
        // Allow authenticated users to create audit logs (client-side logging)
        allow create: if isAuthenticated();
        // Prevent updates and deletes (audit logs should be immutable)
        allow update, delete: if false;
    }

    // 10. Budgets
    match /budgets/{budgetId} {
      function getCompanyId() { return resource != null ? resource.data.companyId : request.resource.data.companyId; }

      allow read: if isAuthenticated() && hasCompanyRole(getCompanyId(), ['financial_manager', 'approver', 'releaser', 'auditor', 'user']);
      allow write: if isAuthenticated() && isManager(getCompanyId());
    }

    // 11. Feedbacks
    match /feedbacks/{feedbackId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isGlobalAdmin();
    }

    // Regras do Roadmap
    match /roadmap_items/{itemId} {
      allow read: if true; // Público
      allow create: if isAuthenticated(); // Usuários logados
      allow update, delete: if isGlobalAdmin(); // Apenas admins
    }

    // 12. Cost Center Usage (Denormalized for performance)
    match /cost_center_usage/{usageId} {
       function getCompanyId() { return resource != null ? resource.data.companyId : request.resource.data.companyId; }
       
       // Read: Same as reports/dashboard
       allow read: if isAuthenticated() && hasCompanyRole(getCompanyId(), ['financial_manager', 'approver', 'releaser', 'auditor', 'user']);
       
       // Write: Only Cloud Functions or strict managers
       allow write: if isAuthenticated() && isManager(getCompanyId());
    }
    
    // 13. Company Stats (Current Balance)
    match /company_stats/{companyId} {
       // Read: All roles in the company
       allow read: if isAuthenticated() && hasCompanyRole(companyId, ['financial_manager', 'approver', 'releaser', 'auditor', 'user']);
       
       // Write: Manager only (for manual recalculation)
       // Note: Cloud Functions bypass these rules.
       allow write: if isAuthenticated() && isManager(companyId);
    }
    
    // 14. Reconciliation Sessions
    match /reconciliation_sessions/{companyId} {
       allow read, write: if isAuthenticated() && hasCompanyRole(companyId, ['financial_manager', 'approver', 'releaser', 'auditor', 'user']);
    }
    
    // ── API Externa ──────────────────────────────────────────────────────────

    // 14. API Keys (gerenciamento das chaves de integração externa)
    // Apenas admins globais ou admins da empresa podem criar/revogar keys.
    // O conteúdo real (hashedKey, encryptedSecretKey) nunca deve ser exibido
    // ao client — as leituras aqui são protegidas intencionalmente.
    match /api_keys/{keyId} {
      // Leitura: Admin global ou admin da empresa vinculada à key
      allow read: if isAuthenticated() && (
        isGlobalAdmin() ||
        (resource != null &&
         hasCompanyRole(resource.data.companyId, ['financial_manager']))
      );
      // Criação e revogação: Admin global ou admin da empresa
      allow create: if isAuthenticated() && isGlobalAdmin();
      allow update: if isAuthenticated() && (
        isGlobalAdmin() ||
        (resource != null &&
         hasCompanyRole(resource.data.companyId, ['financial_manager']))
      );
      // Deleção física não permitida — usar revogar (update active: false)
      allow delete: if false;
    }

    // 15. API Audit Logs (log de chamadas da API externa)
    // Escrita apenas via Admin SDK (Cloud Functions / API Routes server-side).
    // Leitura: admins e auditores da empresa.
    match /api_audit_logs/{logId} {
      allow read: if isAuthenticated() && (
        isGlobalAdmin() ||
        (resource != null &&
         hasCompanyRole(resource.data.companyId, ['financial_manager', 'auditor']))
      );
      // Escrita bloqueada pelo client — somente Admin SDK pode escrever
      allow write: if false;
    }

    // 16. Comprovantes (Payment Receipts)
    match /comprovantes/{comprovanteId} {
      function getCompanyId() { return resource != null ? resource.data.companyId : request.resource.data.companyId; }

      // Read: All authenticated roles in the company
      allow read: if isAuthenticated() && hasCompanyRole(getCompanyId(), ['financial_manager', 'approver', 'releaser', 'auditor', 'user']);

      // Create: Admin and Financial Manager only
      allow create: if isAuthenticated() && isManager(getCompanyId());

      // Update: Admin and Financial Manager only (confirm/reject matches)
      allow update: if isAuthenticated() && isManager(getCompanyId());

      // Delete: Admin only (global admin or company admin)
      allow delete: if isGlobalAdmin();
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}